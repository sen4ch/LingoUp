{
  "name": "@lingoup/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "content:import": "node --env-file-if-exists=../../.env dist/cli/import-content.js",
    "openapi:export": "node --env-file-if-exists=../../.env dist/cli/export-openapi.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.7",
    "@lingoup/ai-sdk": "workspace:*",
    "@lingoup/contracts": "workspace:*",
    "@lingoup/database": "workspace:*",
    "@lingoup/learning-engine": "workspace:*",
    "@lingoup/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "unplugin-swc": "2.0.0"
  }
}
