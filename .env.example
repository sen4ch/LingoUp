# Copy to .env and replace every "change-me" value:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------- PostgreSQL ----------
POSTGRES_USER=lingoup
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=lingoup
# Host port (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
# Used by apps running on the host (pnpm dev, migrations, tests).
DATABASE_URL=postgres://lingoup:change-me-postgres-password@localhost:5432/lingoup
# Integration tests create and drop this database.
TEST_DATABASE_URL=postgres://lingoup:change-me-postgres-password@localhost:5432/lingoup_test

# ---------- Valkey ----------
VALKEY_PASSWORD=change-me-valkey-password
VALKEY_PORT=6379
VALKEY_URL=redis://:change-me-valkey-password@localhost:6379/0

# ---------- API ----------
API_PORT=4000
LOG_LEVEL=info
# Comma-separated origins allowed to send state-changing requests (CSRF protection).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Which proxies may set X-Forwarded-For (the client IP used for rate limits):
# false, true, or a comma-separated list of IPs/CIDRs or presets (loopback, uniquelocal).
# loopback = the Next.js server on the same host (local development).
TRUST_PROXY=loopback
SWAGGER_ENABLED=true

# ---------- AI ----------
# mock        - built-in deterministic placeholder, no model needed (default)
# ai-service  - forward to apps/ai-service (Ollama / vLLM / OpenAI-compatible)
# none        - disable AI; lookups use the curated glossary only
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-ai-service-token-at-least-32-chars
AI_TIMEOUT_MS=20000
AI_MAX_CONCURRENCY=4
AI_MAX_RETRIES=1
AI_DAILY_QUOTA_PER_USER=200
# Allow sending user content to providers that run outside your infrastructure.
# Even when true, each user must opt in (Settings -> AI data sharing).
AI_ALLOW_EXTERNAL=false

# ---------- ai-service (Python) ----------
# mock | ollama | openai-compatible
AI_BACKEND=mock
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
# For vLLM, LocalAI or any OpenAI-compatible endpoint.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# "local" if the endpoint runs on your own infrastructure (e.g. self-hosted vLLM), otherwise "external".
OPENAI_COMPATIBLE_DATA_LOCALITY=external

# ---------- Worker ----------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7
WORKER_CONCURRENCY=10

# ---------- Web ----------
WEB_PORT=3000
# Where the Next.js server proxies /api/* (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4000
